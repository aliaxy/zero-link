# ── Secrets (REQUIRED — no defaults) ──────────────────────────────────────────

# JWT secret for management API tokens. Must be at least 32 characters.
LINK_API_AUTH_SECRET=replace-with-a-32-char-or-longer-secret

# Salt used to pseudonymise visitor IPs in analytics. Any non-empty string.
LINK_RPC_IP_SALT=replace-with-a-unique-ip-salt

# ── MySQL credentials ──────────────────────────────────────────────────────────

MYSQL_DATABASE=zero_link
MYSQL_USER=zerolink
MYSQL_PASSWORD=zerolink
MYSQL_ROOT_PASSWORD=zerolink_root

# ── link-api ───────────────────────────────────────────────────────────────────

# Allowed CORS origin for the admin UI. Defaults to http://localhost:8080.
LINK_API_CORS_ORIGIN=http://localhost:8080
